FROM python:3.12-slim

WORKDIR /app

# git for applications_repo/cv_client checkouts; nodejs+npm to install the
# Claude Code CLI (`claude -p`, ClaudeCliBackend's default) and the Codex
# CLI (`codex exec`, CodexCliBackend) -- see application_writer/llm/ for
# why both are CLI-shellouts rather than API calls (subscription billing,
# not metered per-token pricing) and k8s/secrets.md for how each CLI's
# login session gets into this container. Only ClaudeCliBackend is used by
# the default config.yaml (`llm.stages`) -- Codex ships here so a stage can
# be repointed at it via config alone, no image rebuild needed for that
# part, but it does need its own credentials configured if used.
RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code @openai/codex \
    && apt-get purge -y curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10002 --create-home appwriter

COPY application_writer/requirements.txt application_writer/requirements.txt
RUN pip install --no-cache-dir -r application_writer/requirements.txt

COPY application_writer/ application_writer/
COPY config.yaml config.yaml

RUN mkdir -p /tmp/jobscout-applications && chown appwriter:appwriter /tmp/jobscout-applications

USER appwriter
ENV JOBSCOUT_CONFIG=/app/config.yaml
EXPOSE 8000
CMD ["uvicorn", "application_writer.app:app", "--host", "0.0.0.0", "--port", "8000"]
