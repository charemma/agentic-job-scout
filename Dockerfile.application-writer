FROM python:3.12-slim

WORKDIR /app

# git for applications_repo/cv_client checkouts; nodejs+npm to install the
# Claude Code CLI (`claude -p`), which claude_cli.py shells out to --
# see that module's docstring for why (subscription billing, not metered
# API) and k8s/secrets.md for how the login session gets into this
# container (mounted credentials file, not ANTHROPIC_API_KEY).
RUN apt-get update && apt-get install -y --no-install-recommends git curl \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && npm install -g @anthropic-ai/claude-code \
    && apt-get purge -y curl && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
RUN useradd --system --uid 10002 --create-home appwriter

COPY application_writer/requirements.txt application_writer/requirements.txt
RUN pip install --no-cache-dir -r application_writer/requirements.txt

COPY application_writer/ application_writer/

RUN mkdir -p /tmp/jobscout-applications && chown appwriter:appwriter /tmp/jobscout-applications

USER appwriter
EXPOSE 8000
CMD ["uvicorn", "application_writer.app:app", "--host", "0.0.0.0", "--port", "8000"]
