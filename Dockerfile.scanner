# jobscout-scanner: lightweight, no LaTeX/heavy deps -- just HTTP + parsing.
FROM python:3.12-slim

WORKDIR /app

RUN useradd --system --uid 10001 scanner
COPY scanner/requirements.txt scanner/requirements.txt
RUN pip install --no-cache-dir -r scanner/requirements.txt

COPY scanner/ scanner/
COPY config.yaml config.yaml

USER scanner
ENV JOBSCOUT_CONFIG=/app/config.yaml
CMD ["python", "-m", "scanner.main"]
