# jobscout-scanner: HTTP + parsing, plus Playwright/Chromium for
# login-gated portals (xing, linkedin, solcom -- see their fetcher
# docstrings). Meaningfully heavier than the original HTTP-only image
# (~300-500MB more), but this runs ~4x/day on home-node, not under constant
# load -- accepted tradeoff, see the multi-portal-expansion plan.
FROM python:3.12-slim

WORKDIR /app

RUN useradd --system --uid 10001 --create-home scanner

# git for store.py's applications_repo clone/commit/push
RUN apt-get update && apt-get install -y --no-install-recommends git \
    && rm -rf /var/lib/apt/lists/*

COPY scanner/requirements.txt scanner/requirements.txt
RUN pip install --no-cache-dir -r scanner/requirements.txt

# Installed as root so `--with-deps` can apt-get Chromium's system libs;
# PLAYWRIGHT_BROWSERS_PATH puts the browser in a fixed, non-home location so
# it survives switching to the non-root `scanner` user below.
ENV PLAYWRIGHT_BROWSERS_PATH=/ms-playwright
RUN python -m playwright install --with-deps chromium \
    && chmod -R o+rX /ms-playwright

COPY scanner/ scanner/
COPY config.yaml config.yaml

USER scanner
ENV JOBSCOUT_CONFIG=/app/config.yaml
CMD ["python", "-m", "scanner.main"]
